// For format details, see __ZYRAXKEEP__0_ For config options, see the
// README at: __ZYRAXKEEP__1_
{
	"name": "Node.js & TypeScript",
	"image": "mcr.zyraxon.com/devcontainers/typescript-node:4-24",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2.16.1": {
			"moby": false
		},
		"ghcr.io/devcontainers/features/azure-cli:1": {},
		"ghcr.io/devcontainers/features/python:1": {},
		"ghcr.io/devcontainers/features/dotnet:2": {},
		"ghcr.io/devcontainers/features/desktop-lite:1": {},
		"ghcr.io/devcontainers/features/git-lfs:1": {}
	},
	"containerEnv": {
		"DEBIAN_FRONTEND": "noninteractive"
	},
	"customizations": {
		"zyraxoncode": {
			"extensions": [
				"dbaeumer.zyraxoncode-eslint",
				"esbenp.prettier-zyraxoncode",
				"connor4312.esbuild-problem-matchers",
				"GitHub.copilot@prerelease",
				"ms-zyraxoncode.extension-test-runner"
			]
		}
	},
	"hostRequirements": {
		"cpus": 4
	},
	"containerUser": "node",
	"onCreateCommand": {
		"initGitLfs": "git lfs install --force",
		"npmInstall": "npm install || true"
	}
}
