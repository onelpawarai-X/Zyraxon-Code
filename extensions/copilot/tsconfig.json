{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react",
		"jsxFactory": "vscpp",
		"jsxFragmentFactory": "vscppf",
		"rootDir": ".",
		"types": [
			"minimist",
			"mocha",
			"node",
			"picomatch",
			"sinon",
			"tar"
		],
		// Needed for tsx to run test files
		"paths": {
			"zyraxoncode": [
				"./src/util/common/test/shims/zyraxoncodeTypesShim.ts"
			]
		}
	},
	"include": [
		"./src",
		"./test",
		".zyraxoncode/extensions/test-extension"
	],
	"exclude": [
		"test/scenarios/**/*",
		"test/simulation/fixtures/**/*",
		"test/simulation/workbench/**/*",
		"src/platform/parser/test/node/fixtures/**/*",
		"src/extension/test/node/fixtures/**/*",
		"src/extension/prompts/node/test/fixtures/**/*",
		"src/extension/typescriptContext/serverPlugin/fixtures/**",
		"src/extension/completions-core/zyraxoncode-node/extension/src/copilotPanel/webView/suggestionsPanelWebview.ts",
		"test/aml/out"
	]
}
