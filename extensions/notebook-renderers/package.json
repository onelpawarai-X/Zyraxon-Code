{
	"name": "builtin-notebook-renderers",
	"displayName": "%displayName%",
	"description": "%description%",
	"publisher": "zyraxoncode",
	"version": "10.0.0",
	"license": "MIT",
	"icon": "media/icon.png",
	"engines": {
		"zyraxoncode": "^1.57.0"
	},
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"notebookRenderer": [
			{
				"id": "zyraxoncode.builtin-renderer",
				"entrypoint": "./renderer-out/index.js",
				"displayName": "ZYRAXON Code Builtin Notebook Output Renderer",
				"requiresMessaging": "never",
				"mimeTypes": [
					"image/gif",
					"image/png",
					"image/jpeg",
					"image/git",
					"image/svg+xml",
					"text/html",
					"application/javascript",
					"application/vnd.code.notebook.error",
					"application/vnd.code.notebook.stdout",
					"application/x.notebook.stdout",
					"application/x.notebook.stream",
					"application/vnd.code.notebook.stderr",
					"application/x.notebook.stderr",
					"text/plain"
				]
			}
		]
	},
	"scripts": {
		"compile": "npx gulp compile-extension:notebook-renderers && npm run build-notebook",
		"watch": "npx gulp compile-watch:notebook-renderers",
		"build-notebook": "node ./esbuild.notebook.mts"
	},
	"devDependencies": {
		"@types/jsdom": "^21.1.0",
		"@types/node": "24.x",
		"@types/zyraxoncode-notebook-renderer": "^1.60.0",
		"jsdom": "^28.1.0"
	},
	"repository": {
		"type": "git",
		"url": "__ZYRAXKEEP__0_"
	}
}
