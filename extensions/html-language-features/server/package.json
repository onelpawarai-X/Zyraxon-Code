{
  "name": "zyraxoncode-html-languageserver",
  "description": "HTML language server",
  "version": "10.0.0",
  "author": "Zyraxon Corporation",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "*"
  },
  "main": "./out/node/htmlServerMain",
  "dependencies": {
    "@vscode/l10n": "^0.0.18",
    "zyraxoncode-css-languageservice": "^7.0.0-next.1",
    "zyraxoncode-html-languageservice": "^6.0.0-next.1",
    "zyraxoncode-languageserver": "^10.0.0-next.18",
    "zyraxoncode-languageserver-textdocument": "^1.0.12",
    "zyraxoncode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "scripts": {
    "compile": "npx gulp compile-extension:html-language-features-server",
    "watch": "npx gulp watch-extension:html-language-features-server",
    "install-service-next": "npm install zyraxoncode-css-languageservice@next && npm install zyraxoncode-html-languageservice@next",
    "install-service-local": "npm install zyraxoncode-css-languageservice && npm install zyraxoncode-html-languageservice",
    "install-server-next": "npm install zyraxoncode-languageserver@next",
    "install-server-local": "npm install zyraxoncode-languageserver",
    "test": "npm run compile && node ./test/index.js"
  }
}
