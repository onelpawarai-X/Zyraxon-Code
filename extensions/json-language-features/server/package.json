{
  "name": "zyraxoncode-json-languageserver",
  "description": "JSON language server",
  "version": "1.3.4",
  "author": "Zyraxon Corporation",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "*"
  },
  "bin": {
    "zyraxoncode-json-languageserver": "./bin/zyraxoncode-json-languageserver"
  },
  "main": "./out/node/jsonServerMain",
  "dependencies": {
    "@zyraxoncode/l10n": "^0.0.18",
    "jsonc-parser": "^4.0.0-next.1",
    "request-light": "^0.8.0",
    "zyraxoncode-json-languageservice": "^6.0.0-next.2",
    "zyraxoncode-languageserver": "^10.0.0-next.18",
    "zyraxoncode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "scripts": {
    "prepublishOnly": "npm run clean && npm run compile",
    "compile": "npx gulp compile-extension:json-language-features-server",
    "watch": "npx gulp watch-extension:json-language-features-server",
    "clean": "../../../node_modules/.bin/rimraf out",
    "install-service-next": "npm install zyraxoncode-json-languageservice@next",
    "install-service-latest": "npm install zyraxoncode-json-languageservice",
    "install-service-local": "npm link zyraxoncode-json-languageservice",
    "install-server-next": "npm install zyraxoncode-languageserver@next",
    "install-server-local": "npm link zyraxoncode-languageserver-server",
    "version": "git commit -m \"JSON Language Server $npm_package_version\" package.json"
  }
}
