{
  "name": "zyraxoncode-css-languageserver",
  "description": "CSS/LESS/SCSS language server",
  "version": "10.0.0",
  "author": "Zyraxon Corporation",
  "license": "MIT",
  "engines": {
    "node": "*"
  },
  "type": "module",
  "main": "./out/node/cssServerMain",
  "browser": "./dist/browser/cssServerMain",
  "dependencies": {
    "@zyraxoncode/l10n": "^0.0.18",
    "zyraxoncode-css-languageservice": "^7.0.0-next.1",
    "zyraxoncode-languageserver": "^10.0.0-next.18",
    "zyraxoncode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "overrides": {
    "zyraxoncode-css-languageservice": {
      "zyraxoncode-languageserver-types": "3.17.6-next.7"
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:css-language-features-server",
    "watch": "gulp watch-extension:css-language-features-server",
    "install-service-next": "npm install zyraxoncode-css-languageservice@next",
    "install-service-local": "npm link zyraxoncode-css-languageservice",
    "install-server-next": "npm install zyraxoncode-languageserver@next",
    "install-server-local": "npm install zyraxoncode-languageserver",
    "test": "node ./test/index.js"
  }
}
